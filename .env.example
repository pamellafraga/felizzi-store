# WhatsApp da loja (DDI + DDD + número, só dígitos). Sem este valor, o botão abre o Instagram.
NEXT_PUBLIC_WHATSAPP_E164=

# Shopify Storefront — demo via apparel-plus.mock.shop (moda plus-size, sem token).
# Para a loja real da Felizzi, troque o domínio e o token públicos.

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=apparel-plus.mock.shop
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=public
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01
